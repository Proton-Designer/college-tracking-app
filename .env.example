# ── Supabase ────────────────────────────────────────────────────────────────
# Local dev: run `npm run db:start` then `supabase status -o env`
# Cloud: Project Settings → API. See docs/SUPABASE_SETUP.md
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server/Edge Functions ONLY — never ship to a client
SUPABASE_DB_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Anthropic (Edge Function secret only — never a PUBLIC var) ───────────────
ANTHROPIC_API_KEY=
LLM_MONTHLY_BUDGET_USD=10

# ── Integrations (added in L10) ─────────────────────────────────────────────
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_WEBHOOK_SECRET=
RESCUETIME_API_KEY=
