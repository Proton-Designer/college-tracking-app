# deps
node_modules/
.pnp.*
.yarn/*

# builds
dist/
build/
.next/
out/
.expo/
*.tsbuildinfo

# env & secrets
.env
.env.*
!.env.example
*.pem
.secrets/

# supabase local
supabase/.temp/
supabase/.branches/

# test artifacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/
**/e2e/.auth/

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
logs/

# native
ios/Pods/
android/.gradle/
*.keystore
!debug.keystore

# scratch / throwaway scripts (must never be committed)
*.tmp-*
.tmp-*
**/.tmp-*

# Playwright MCP session artifacts — regenerated every session, never source
.playwright-mcp/

# Verification screenshots under .brain/ are ephemeral evidence, not source. 93 of them were
# tracked (21MB), which is what pushed .git to 40MB. The knowledge base itself --
# .brain/memory/*.md -- stays tracked; it is the durable part.
.brain/*.png
.brain/*.jpg
.brain/*.jpeg
.brain/mobile-shots/
.brain/web-shots/
