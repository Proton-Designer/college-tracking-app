{
  "name": "collegeos",
  "private": true,
  "version": "0.1.0",
  "description": "CollegeOS — a personal closed-loop college accountability operating system.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check:imports && npm run check:core-mirror && npm run check:barrel-exports && npm run check:demo-clean && npm run typecheck && npm run lint && npm run test",
    "test:e2e": "npm run test:e2e --workspace=@collegeos/web",
    "sim:shot": "bash scripts/sim-shot.sh",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > packages/api/src/database.types.ts",
    "db:test": "supabase test db",
    "check:imports": "node scripts/check-imports.mjs",
    "build:core-for-deno": "node scripts/build-core-for-deno.mjs",
    "check:core-mirror": "node scripts/check-core-mirror.mjs",
    "check:barrel-exports": "node scripts/check-barrel-exports.mjs",
    "check:demo-clean": "node scripts/check-demo-clean.mjs",
    "make:test-user": "node scripts/make-test-user.mjs",
    "clean:test-users": "node scripts/delete-test-user.mjs --all-verify"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
