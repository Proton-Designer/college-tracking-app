{
  "name": "@collegeos/api",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Supabase data-access layer, shared by apps/web and apps/mobile.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/platform/web.ts",
    "./native": "./src/platform/native.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@collegeos/core": "*",
    "@supabase/supabase-js": "2.112.3"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/ssr": "0.12.4"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": { "optional": true },
    "@supabase/ssr": { "optional": true }
  },
  "devDependencies": {
    "@collegeos/config": "*",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
